# Copy to .env and fill in. Never commit .env.

# Embeddings: "sbert" (MiniLM, better, downloads ~90 MB once) or "tfidf" (offline, no download)
EMBEDDING_BACKEND=sbert
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: override the confidence threshold chosen during training
# CONFIDENCE_THRESHOLD=0.80

# ---- Optional LLM (any OpenAI compatible endpoint). Leave blank to use rules only. ----
# Groq (free tier, fast): create a key at console.groq.com, pick a model from its model list
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.1-8b-instant
#
# Cloudflare Workers AI (10,000 free Neurons per day):
# LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# LLM_API_KEY=<API token with Workers AI permission>
# LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
#
# Ollama on your laptop (unlimited, offline). From Docker use host.docker.internal instead of localhost.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- Slack (Socket Mode). See README "Slack setup". ----
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_INTAKE_CHANNEL=comms-requests
SLACK_REVIEW_CHANNEL=triage-review
# Optional JSON to rename team channels, e.g. {"PR": "pr-team"}
# SLACK_TEAM_CHANNELS=
